# MF Project Tracker — macOS menu bar + WidgetKit
# Copy via: npm run mf-macos:env   (or ./scripts/sync-env.sh)
# Source of truth: repo-root local.env (same keys as Expo / mf-desktop).
#
# Build embeds these into App + Widgets Info.plist; sync-env also seeds the App Group
# so Sign In / intents share GraphQL URL, X-Bundle-ID, X-API-Key, and Particular key.

# Dev GraphQL (core-base mf-go). localhost → 127.0.0.1 on sync.
EXPO_PUBLIC_DEV_GRAPHQL_URL=http://127.0.0.1:8080/graphql
EXPO_PUBLIC_GRAPHQL_URL=http://127.0.0.1:8080/graphql

# Registered client app (mf-go client_apps) — same as Expo
EXPO_PUBLIC_MF_BUNDLE_ID=com.masterfabric.monoExpo

# From mf-go client_apps.api_key for that bundle (required for auth / Particular hops)
# Prefer generating local.env:
#   ../masterfabric-particulars/scripts/print-mf-project-tracker-env.sh > local.env
EXPO_PUBLIC_MF_APP_API_KEY=

# Org projects hop via particularGraphqlEnvelope
EXPO_PUBLIC_MF_PROJECT_TRACKER_PARTICULAR=project_tracker
