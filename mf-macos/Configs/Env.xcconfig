// Safe defaults first; GeneratedEnv (from ./scripts/sync-env.sh) overrides when present.
// Xcode xcconfig: later assignments win — never blank MF_APP_API_KEY after the include
// (that wiped the synced key and made refreshTokens return TOKEN_INVALID / Session expired).
GRAPHQL_URL = http://127.0.0.1:8080/graphql
MF_CLIENT_BUNDLE_ID = com.masterfabric.monoExpo
MF_PROJECT_TRACKER_PARTICULAR = project_tracker

#include? "GeneratedEnv.xcconfig"
