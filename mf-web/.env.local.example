# core-base mf-go GraphQL (same as mobile)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql
# Particular key for org projects / todos
NEXT_PUBLIC_MF_PROJECT_TRACKER_PARTICULAR=project_tracker
# App identity (required for orgs + particularGraphqlEnvelope)
NEXT_PUBLIC_MF_BUNDLE_ID=com.masterfabric.monoExpo
# From mf-go client_apps.api_key for that bundle (local only — do not commit)
NEXT_PUBLIC_MF_API_KEY=
