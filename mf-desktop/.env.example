# core-base mf-go GraphQL (same as mf-web / local.env)
VITE_GRAPHQL_URL=http://127.0.0.1:8080/graphql
# Particular key for org projects / todos
VITE_MF_PROJECT_TRACKER_PARTICULAR=project_tracker
# App identity (required for orgs + particularGraphqlEnvelope)
VITE_MF_BUNDLE_ID=com.masterfabric.monoExpo
# From mf-go client_apps.api_key for that bundle (local only — do not commit)
# Prefer: npm run env:sync  (maps repo-root local.env → this file)
VITE_MF_API_KEY=

# Optional GitHub panel defaults (repo issues/PRs via GitHub REST — not mf-go)
# VITE_GITHUB_REPO=owner/repo
# VITE_GITHUB_TOKEN=                    # PAT for private repos; prefer Settings → link UI (userData)
# VITE_MF_CORE_URL=https://core.masterfabric.co
