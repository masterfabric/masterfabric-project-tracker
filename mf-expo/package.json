{
  "name": "masterfabric-expo",
  "displayName": "MF Project Tracker",
  "description": "Project tracking application connected to mf-go GraphQL backend",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "stage": "development",
  "author": {
    "name": "Gürkan Fikret Günak",
    "email": "gurkanfikretgunak@masterfabric.co"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/masterfabric/masterfabric-project-tracker.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "fabric-design",
    "mobile-app",
    "typescript",
    "masterfabric"
  ],
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "start:dev": "EXPO_DEV_BUILD=1 expo start",
    "start:ios": "expo start --ios",
    "start:ios:dev": "EXPO_DEV_BUILD=1 expo start",
    "start:live": "expo start --clear",
    "start:expo-go": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "EXPO_DEV_BUILD=1 expo run:android",
    "ios": "EXPO_DEV_BUILD=1 expo run:ios",
    "ios:device": "EXPO_DEV_BUILD=1 expo run:ios --device",
    "ios:live": "EXPO_DEV_BUILD=1 expo run:ios",
    "clean:android": "node -e \"const fs=require('fs'),p='android/app/build',q='android/build';[p,q].forEach(d=>{try{fs.rmSync(d,{recursive:true});console.log('Removed '+d)}catch(e){}})\"",
    "clean:ios": "node -e \"const fs=require('fs'),d='ios/build';try{fs.rmSync(d,{recursive:true});console.log('Removed '+d)}catch(e){}\"",
    "clean": "npm run clean:android && npm run clean:ios",
    "xcode": "open ios/MFProjectTracker.xcworkspace",
    "web": "expo start --web",
    "build:ios": "./scripts/build-ipa-pipeline.sh",
    "build:ios:eas": "npx eas-cli@latest build --platform ios",
    "build:ios:local": "./scripts/build-ipa-pipeline.sh",
    "build:ios:manual": "open ios/MasterFabric.xcworkspace",
    "build:ios:pipeline": "./scripts/build-ipa-pipeline.sh",
    "build:ios:check": "./scripts/check-build-setup.sh",
    "build:android": "./scripts/build-aab-pipeline.sh",
    "build:android:check": "./scripts/check-android-setup.sh",
    "simulator:install": "./scripts/install-simulator.sh",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n-keys.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/react": "~19.2.10",
    "eslint-config-expo": "~55.0.0",
    "expo": "^55.0.6",
    "expo-av": "~16.0.8",
    "expo-battery": "~55.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-calendar": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-contacts": "~55.0.8",
    "expo-dev-client": "~55.0.16",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.12",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-local-authentication": "~55.0.8",
    "expo-localization": "~55.0.8",
    "expo-location": "~55.1.2",
    "expo-media-library": "~55.0.9",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.9",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.9",
    "expo-tracking-transparency": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "firebase": "^12.8.0",
    "graphql": "^16.9.0",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.0.7",
    "i18n-js": "^4.5.1",
    "lucide-react-native": "^1.7.0",
    "masterfabric-expo-core": "workspace:*",
    "onesignal-expo-plugin": "^2.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-onesignal": "^5.3.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-wheel-color-picker": "^1.3.1",
    "react-native-worklets": "0.7.2",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.0",
    "jest": "~29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "minimatch": "^10.2.1",
    "glob": "^13.0.0"
  },
  "private": true
}
