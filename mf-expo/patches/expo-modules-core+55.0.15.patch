@@ -0,0 +1,31 @@
+// Copyright 2018-present 650 Industries. All rights reserved.
+// Compatibility implementation for legacy modules (e.g. expo-av) - bridges to LegacyEventEmitterCompat.
+
+#import <ExpoModulesCore/EXEventEmitterService.h>
+#import <ExpoModulesCore/EXDefines.h>
+#import <ExpoModulesCore/Swift.h>
+
+@interface EXLegacyEventEmitterService : NSObject <EXInternalModule, EXEventEmitterService>
+@property (nonatomic, weak) EXAppContext *appContext;
+@end
+
+@implementation EXLegacyEventEmitterService
+
+EX_REGISTER_MODULE();
+
++ (const NSArray<Protocol *> *)exportedInterfaces
+{
+  return @[@protocol(EXEventEmitterService)];
+}
+
+- (void)setAppContext:(EXAppContext *)appContext
+{
+  _appContext = appContext;
+}
+
+- (void)sendEventWithName:(NSString *)eventName body:(id)body
+{
+  [_appContext sendLegacyEventWithName:eventName body:body];
+}
+
+@end
