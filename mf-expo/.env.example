# ═══════════════════════════════════════════════════════════════════════════════
# MasterFabric mf-expo — Environment variables (EXPO_PUBLIC_* are inlined at build)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to `.env.development` and/or `.env` in this directory (mf-expo/).
# Do not commit files with real secrets (use .gitignore).
#
# Load order (see app.config.js):
#   .env → .env.development → .env.local → ../local.env  (last file wins on conflict)
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# mf-go GraphQL (required for API) — **core-base mf-go**
# Auth, orgs, personal todos call this URL directly.
# Org projects / todos / purchases hop via particularGraphqlEnvelope → particular-project-tracker.
# ───────────────────────────────────────────────────────────────────────────────
# "Prod" URL in the in-app environment switcher (AsyncStorage + extra.graphqlUrl).
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# "Dev" URL when user selects Dev in the GraphQL environment switcher.
EXPO_PUBLIC_DEV_GRAPHQL_URL=http://localhost:8080/graphql

# Particular key registered on mf-go for project-tracker (default: project_tracker).
EXPO_PUBLIC_MF_PROJECT_TRACKER_PARTICULAR=project_tracker
# Ops/health only (app GraphQL still goes through mf-go). Port registry: 39205.
EXPO_PUBLIC_MF_PARTICULAR_PORT=39205
EXPO_PUBLIC_MF_PARTICULAR_BASE_URL=http://127.0.0.1:39205

# Legacy / generic REST base (defaults used in constants if unset).
EXPO_PUBLIC_API_URL=https://api.masterfabric.co

# ───────────────────────────────────────────────────────────────────────────────
# App metadata
# ───────────────────────────────────────────────────────────────────────────────
# Numeric App Store ID for Settings → iOS-only App Store banner (itms-apps link). Optional (search fallback).
EXPO_PUBLIC_IOS_APP_STORE_ID=

EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_DEBUG_MODE=true

# ───────────────────────────────────────────────────────────────────────────────
# Firebase (optional — Web SDK / RN Firebase)
# ───────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ───────────────────────────────────────────────────────────────────────────────
# OneSignal (push)
# ───────────────────────────────────────────────────────────────────────────────
# Local: set here + restart Metro. EAS cloud builds do NOT read this file — set the
# same key in Expo (expo.dev → your project → Environment variables) for each
# Public OneSignal App ID only — do NOT put the OneSignal REST API Key in the app;
# server-side push (broadcasts, todo assignment/due) uses ONESIGNAL_* on mf-go.
#
# EAS environment (development / preview / production) so app.config.js can embed
# extra.oneSignalAppId at prebuild. If this is empty in a store/internal build,
# OneSignal never inits (push works on dev machine only).
#
# iOS production: onesignal-expo-plugin uses mode "production" when EAS_BUILD_PROFILE
# is production — upload APNs Auth Key (.p8) in OneSignal → Apple iOS (sandbox vs
# production must match the build). Override: EXPO_PUBLIC_ONESIGNAL_MODE=development|production
EXPO_PUBLIC_ONE_SIGNAL_APP_ID=

# ───────────────────────────────────────────────────────────────────────────────
# Sentry (optional)
# ───────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ───────────────────────────────────────────────────────────────────────────────
# Supabase (optional — if you enable Supabase in MasterView config)
# ───────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
