# organizations.graphqls — Organization management queries and mutations

extend type Query {
  """List all organizations the authenticated user belongs to (active membership)."""
  myOrganizations: [Organization!]!
  """Single organization (requires active membership)."""
  organization(organizationId: UUID!): Organization!
  """List pending organization invitations for the authenticated user."""
  myPendingInvitations: [OrganizationInvitation!]!
  """List members of an organization (requires membership)."""
  organizationMembers(orgId: UUID!): [OrganizationMember!]!
  """List all invitations for an organization (requires admin or owner)."""
  organizationInvitations(orgId: UUID!): [OrganizationInvitation!]!
  """News posts for members (newest first)."""
  organizationNews(organizationId: UUID!, limit: Int, before: Time): [OrganizationNews!]!
  """Org-wide chat messages (newest first)."""
  organizationMessages(organizationId: UUID!, limit: Int, before: Time): [OrganizationMessage!]!
}

extend type Mutation {
  """Create a new organization (creator becomes owner)."""
  createOrganization(input: CreateOrganizationInput!): Organization!
  """Update organization profile (admin or owner)."""
  updateOrganization(input: UpdateOrganizationInput!): Organization!
  """Remove a member (admin or owner). Cannot remove the owner."""
  removeOrganizationMember(organizationId: UUID!, userId: UUID!): Boolean!
  """Leave the organization (removes own membership). Organization owners must transfer ownership first."""
  leaveOrganization(organizationId: UUID!): Boolean!
  """Set member suspended (passive) or active (admin or owner). Cannot target the owner."""
  setOrganizationMemberSuspended(organizationId: UUID!, userId: UUID!, suspended: Boolean!): Boolean!
  """Invite a user by email to an organization."""
  inviteToOrganization(input: InviteToOrganizationInput!): OrganizationInvitation!
  """Accept a pending organization invitation."""
  acceptInvitation(invitationId: UUID!): OrganizationInvitation!
  """Decline a pending organization invitation."""
  declineInvitation(invitationId: UUID!): OrganizationInvitation!
  """Revoke a pending invitation (organization admin or owner)."""
  revokeOrganizationInvitation(invitationId: UUID!): OrganizationInvitation!
  """Refresh a pending invitation: sets inviter to the caller and updates the timestamp (admin or owner)."""
  resendOrganizationInvitation(invitationId: UUID!): OrganizationInvitation!
  """Create news (organization owner only)."""
  createOrganizationNews(input: CreateOrganizationNewsInput!): OrganizationNews!
  """Update news (organization owner only)."""
  updateOrganizationNews(input: UpdateOrganizationNewsInput!): OrganizationNews!
  """Delete news (organization owner only)."""
  deleteOrganizationNews(newsId: UUID!): Boolean!
  """Post a message to the organization channel (active members)."""
  postOrganizationMessage(organizationId: UUID!, body: String!): OrganizationMessage!
  """Delete a chat message in the organization (organization owner only)."""
  deleteOrganizationMessage(organizationId: UUID!, messageId: UUID!): Boolean!
}

extend type Subscription {
  """Real-time: new message in the organization channel (active members only)."""
  organizationMessageCreated(organizationId: UUID!): OrganizationMessage!
}

# ── Inputs ──────────────────────────────────────────────────────────────────

input CreateOrganizationInput {
  name: String!
}

input UpdateOrganizationInput {
  organizationId: UUID!
  name:           String
  description:    String
  logoURL:        String
  websiteURL:     String
  contactEmail:   String
}

input InviteToOrganizationInput {
  organizationId: UUID!
  inviteeEmail:   String!
}

input CreateOrganizationNewsInput {
  organizationId: UUID!
  title:          String!
  description:    String
  imageURL:       String
  """Optional JSON string for rich metadata."""
  richMetadata:   String
}

input UpdateOrganizationNewsInput {
  newsId:       UUID!
  title:        String
  description:  String
  imageURL:     String
  richMetadata: String
}

# ── Response types ───────────────────────────────────────────────────────────

type Organization {
  id:            UUID!
  name:          String!
  description:   String!
  logoURL:       String!
  websiteURL:    String!
  contactEmail:  String!
  ownerUserID:   UUID!
  createdAt:     Time!
  updatedAt:     Time!
}

type OrganizationMember {
  id:               UUID!
  organizationID:   UUID!
  userID:           UUID!
  """Display nickname of the user (from their profile)."""
  userNickname:     String!
  role:             OrganizationMemberRole!
  membershipStatus: OrganizationMembershipStatus!
  joinedAt:         Time!
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
}

type OrganizationInvitation {
  id:             UUID!
  organizationID: UUID!
  inviterID:      UUID!
  inviteeEmail:   String!
  status:         OrganizationInvitationStatus!
  createdAt:      Time!
  """Set when listing the invitee's pending invitations (organization name for display)."""
  organizationName: String
  """Inviter display name when listing the invitee's pending invitations (nickname or display name)."""
  inviterNickname: String
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

type OrganizationNews {
  id:             UUID!
  organizationID: UUID!
  authorUserID:   UUID!
  authorNickname: String!
  title:          String!
  description:    String!
  imageURL:       String!
  richMetadata:   String
  createdAt:      Time!
  updatedAt:      Time!
}

type OrganizationMessage {
  id:             UUID!
  organizationID: UUID!
  authorUserID:   UUID!
  authorNickname: String!
  body:           String!
  createdAt:      Time!
}
