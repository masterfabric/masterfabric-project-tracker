# otp.graphqls — OTP (one-time password) mutations, queries, and types

extend type Mutation {
  """Request a new OTP code for the authenticated user."""
  requestOTP(input: RequestOTPInput!): OTPRequestPayload!

  """Verify an OTP code for the authenticated user."""
  verifyOTP(input: VerifyOTPInput!): OTPVerifyPayload!

  """(Admin) Trigger an OTP for any user by user ID."""
  adminRequestOTP(input: AdminRequestOTPInput!): OTPRequestPayload!
}

extend type Query {
  """(Admin) List all currently pending OTP codes across all users."""
  adminPendingOTPs(limit: Int, offset: Int): [AdminOTPEntry!]!

  """(Admin) View OTP history for a specific user."""
  adminUserOTPHistory(userID: UUID!, limit: Int, offset: Int): [AdminOTPEntry!]!
}

# ── Inputs ──────────────────────────────────────────────────────────────────

input RequestOTPInput {
  """Purpose of the OTP: LOGIN, VERIFY_IDENTITY, PASSWORD_RESET, ACCOUNT_ACTIVATE, EMAIL_CHANGE."""
  purpose: OTPPurpose!
}

input VerifyOTPInput {
  """The 6-digit code the user received."""
  code: String!
  """Purpose must match the original request."""
  purpose: OTPPurpose!
}

input AdminRequestOTPInput {
  """Target user to generate an OTP for."""
  userID: UUID!
  """Purpose of the OTP."""
  purpose: OTPPurpose!
}

# ── Enums ───────────────────────────────────────────────────────────────────

enum OTPPurpose {
  LOGIN
  VERIFY_IDENTITY
  PASSWORD_RESET
  ACCOUNT_ACTIVATE
  """Code sent to your current sign-in email before changing it (see updateProfile.email + emailChangeOtpId)."""
  EMAIL_CHANGE
}

enum OTPChannel {
  ADMIN_PANEL
  EMAIL
  SMS
  WHATSAPP
  TELEGRAM
}

enum OTPStatus {
  PENDING
  VERIFIED
  EXPIRED
}

# ── Response types ───────────────────────────────────────────────────────────

type OTPRequestPayload {
  """ID of the generated OTP record."""
  otpID: UUID!
  """Channel used for delivery."""
  channel: OTPChannel!
  """When the code expires."""
  expiresAt: Time!
}

type OTPVerifyPayload {
  """True if the code was correct."""
  verified: Boolean!
  """ID of the verified OTP record."""
  otpID: UUID!
}

"""Admin view of an OTP entry (includes the code itself for admin panel delivery)."""
type AdminOTPEntry {
  id:         UUID!
  userID:     UUID!
  code:       String!
  channel:    OTPChannel!
  purpose:    OTPPurpose!
  status:     OTPStatus!
  attempts:   Int!
  maxRetries: Int!
  expiresAt:  Time!
  verifiedAt: Time
  createdAt:  Time!
}
