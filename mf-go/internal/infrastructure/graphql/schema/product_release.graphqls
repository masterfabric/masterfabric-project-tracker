# product_release.graphqls — Public published version + changelog; admin mutation to update.

extend type Query {
  """
  Public: admin-published product version and changelog (Markdown).
  No authentication required. Clients should keep copy in sync with repository CHANGELOG.md.
  """
  productRelease: ProductRelease!
}

extend type Mutation {
  """[Admin] Update the published product version and Markdown changelog for all clients."""
  adminUpdateProductRelease(input: AdminProductReleaseInput!): ProductRelease!
}

type ProductRelease {
  version: String!
  """Markdown body (e.g. sections per release: version, date, author, changes)."""
  changelogMarkdown: String!
  updatedAt: Time!
  """Display name of the admin who last published this release info."""
  updatedByDisplayName: String
}

input AdminProductReleaseInput {
  version: String!
  changelogMarkdown: String!
}
