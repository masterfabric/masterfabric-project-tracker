# todos.graphqls — User todo queries and mutations

extend type Query {
  """List all todos for the authenticated user."""
  myTodos: [UserTodo!]!
}

extend type Mutation {
  """Create a new todo for the authenticated user."""
  createTodo(input: CreateTodoInput!): UserTodo!

  """Update an existing todo."""
  updateTodo(input: UpdateTodoInput!): UserTodo!

  """Delete a todo."""
  deleteTodo(id: UUID!): Boolean!

  """Add a checklist item under a user todo (GFG-117). Same access as the parent task."""
  createUserTodoSubtask(input: CreateUserTodoSubtaskInput!): UserTodoSubtask!
  """Update a subtask title and/or completion."""
  updateUserTodoSubtask(input: UpdateUserTodoSubtaskInput!): UserTodoSubtask!
  """Remove a subtask."""
  deleteUserTodoSubtask(id: UUID!): Boolean!
}

# ── Inputs ──────────────────────────────────────────────────────────────────

input CreateTodoInput {
  title:            String!
  completed:        Boolean
  organizationID:   UUID
  assignedToUserID: UUID
  """When set, todo is due at this instant (RFC3339). Omit for no due time."""
  dueAt:            Time
}

input UpdateTodoInput {
  id:                 UUID!
  title:              String
  completed:          Boolean
  organizationID:     UUID
  clearOrganization:  Boolean  # When true, move todo to personal (clears org + assignee)
  assignedToUserID:   UUID
  """Set or replace due time (RFC3339). Omit to leave unchanged unless clearDueAt is set."""
  dueAt:              Time
  """When true, clears due time."""
  clearDueAt:         Boolean
}

# ── Response types ───────────────────────────────────────────────────────────

type UserTodo {
  id:               UUID!
  userID:           UUID!
  title:            String!
  completed:        Boolean!
  organizationID:   UUID
  assignedToUserID: UUID
  """When set, scheduled due moment (UTC)."""
  dueAt:            Time
  createdAt:        Time!
  updatedAt:        Time!
  """Single-level checklist items under this task."""
  subtasks: [UserTodoSubtask!]!
}

type UserTodoSubtask {
  id:         UUID!
  userTodoId: UUID!
  title:      String!
  completed:  Boolean!
  sortOrder:  Int!
  createdAt:  Time!
  updatedAt:  Time!
}

input CreateUserTodoSubtaskInput {
  userTodoId: UUID!
  title:      String!
  completed:  Boolean
}

input UpdateUserTodoSubtaskInput {
  id:        UUID!
  title:     String
  completed: Boolean
}
