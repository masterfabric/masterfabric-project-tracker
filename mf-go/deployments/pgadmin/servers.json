{
  "Servers": {
    "1": {
      "Name": "mf-go Postgres (compose)",
      "Group": "MasterFabric",
      "Host": "postgres",
      "Port": 5432,
      "MaintenanceDB": "masterfabric_basic",
      "Username": "masterfabric",
      "SSLMode": "prefer",
      "Comment": "Dev stack from mf-go/deployments/docker-compose.yml — password via mounted pgpass.",
      "ConnectionParameters": {
        "sslmode": "disable",
        "connect_timeout": 15,
        "passfile": "/var/lib/pgadmin/.pgpass"
      }
    }
  }
}
