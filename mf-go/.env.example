# ═══════════════════════════════════════════════════════════════════════════════
# MasterFabric mf-go — Environment variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to `.env` in this directory (mf-go/). Never commit real secrets.
# The server and migrate CLI load this file automatically via godotenv (cwd should be mf-go/).
# Production checklist: docs/SECURITY.md
#
# All keys below match internal/shared/config/config.go (Load + Validate).
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Runtime
# ───────────────────────────────────────────────────────────────────────────────
# development | staging | production
# Controls: GRAPHQL_INTROSPECTION/PLAYGROUND defaults, REDIS_REQUIRED default, JWT checks.
ENV=development

# ───────────────────────────────────────────────────────────────────────────────
# HTTP server
# ───────────────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
# Primary listen port. PaaS often injects PORT — that wins over SERVER_PORT.
SERVER_PORT=8080
PORT=
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# When true, never send Strict-Transport-Security (use if TLS termination breaks X-Forwarded-Proto).
HTTP_DISABLE_HSTS=false

# ───────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ───────────────────────────────────────────────────────────────────────────────
# Local docker-compose maps 5433→5432. In-container DSN uses host `postgres:5432`.
# SECURITY (production): use sslmode=require or sslmode=verify-full
DATABASE_DSN=postgres://masterfabric:masterfabric@localhost:5433/masterfabric_basic?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_IDLE=5m

# ───────────────────────────────────────────────────────────────────────────────
# Redis
# ───────────────────────────────────────────────────────────────────────────────
# REDIS_URL overrides ADDR/PASSWORD/DB when set (e.g. redis://user:pass@host:6379/0).
REDIS_URL=
REDIS_ADDR=localhost:6380
# docker-compose Redis uses requirepass devredis — set the same when hitting compose from the host.
REDIS_PASSWORD=devredis
REDIS_DB=0
# If true, process exits when Redis is unreachable. Defaults true when ENV=production.
REDIS_REQUIRED=false
# Connection pool: mf-go applies managed-Redis defaults (idle conn recycle ~3m, dial/read/write 5s,
# min idle conns, retries). Tuning: see go-redis Options / REDIS_URL query parameters where supported.

# ───────────────────────────────────────────────────────────────────────────────
# OneSignal (optional) — task assignment + due-time push via REST API
# ───────────────────────────────────────────────────────────────────────────────
# Same App ID as the mobile app (EXPO_PUBLIC_ONE_SIGNAL_APP_ID). REST API Key: OneSignal Dashboard → Keys & IDs.
# When REST_API_KEY is empty, mf-go does not call OneSignal (todos still save normally).
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ───────────────────────────────────────────────────────────────────────────────
# Redis-backed cache TTLs (JWT blacklist, refresh tokens, settings/productRelease cache, OTP, etc.)
# ───────────────────────────────────────────────────────────────────────────────
CACHE_KEY_PREFIX=
CACHE_DEFAULT_TTL=5m
# Should be ≥ JWT_ACCESS_TTL
CACHE_TOKEN_BLACKLIST_TTL=15m
# Should match JWT_REFRESH_TTL
CACHE_REFRESH_TOKEN_TTL=168h
CACHE_USER_SETTINGS_TTL=10m
CACHE_APP_SETTINGS_TTL=30m
# Public productRelease GraphQL row (invalidated on adminUpdateProductRelease)
CACHE_PRODUCT_RELEASE_TTL=5m

# ───────────────────────────────────────────────────────────────────────────────
# RabbitMQ (event bus; falls back to in-process bus if disabled/unreachable)
# ───────────────────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=masterfabric.events

# ───────────────────────────────────────────────────────────────────────────────
# JWT
# ───────────────────────────────────────────────────────────────────────────────
# SECURITY: Production refuses to start if JWT_SECRET is default or < 32 chars.
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=168h
# Max concurrent refresh-token sessions per user in Redis (each login/device adds one). Oldest sessions are revoked when over limit. Set to 0 for unlimited.
AUTH_MAX_REFRESH_SESSIONS_PER_USER=10

# ───────────────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
# When ENV=production and this is unset, mf-go defaults to warn (less stdout noise on PaaS).
LOG_LEVEL=info
# LOG_FORMAT: json | text
LOG_FORMAT=json

# ───────────────────────────────────────────────────────────────────────────────
# GraphQL
# ───────────────────────────────────────────────────────────────────────────────
# When ENV=production, introspection & playground default false unless overridden.
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true
GRAPHQL_COMPLEXITY_LIMIT=300
# Wired to gqlgen handler (extension DEPTH_LIMIT_EXCEEDED when exceeded).
GRAPHQL_QUERY_DEPTH_LIMIT=15

# ───────────────────────────────────────────────────────────────────────────────
# CORS
# ───────────────────────────────────────────────────────────────────────────────
# Comma-separated origins. "*" is dev-only; set explicit origins in production.
CORS_ALLOWED_ORIGINS=*

# ───────────────────────────────────────────────────────────────────────────────
# OTP delivery
# ───────────────────────────────────────────────────────────────────────────────
# admin_panel     — codes only in admin GraphQL + logs (default).
# email           — SMTP (requires SMTP_* below).
# both            — email + admin log; stored channel email.
# whatsapp        — Meta WhatsApp Cloud API (profile phone, country code, digits only).
# whatsapp_both   — WhatsApp + admin log.
# telegram        — Telegram Bot API (user sets telegramChatId via updateProfile).
# telegram_both   — Telegram + admin log.
OTP_DELIVERY=admin_panel
#
# ── Local dev: OTP by email (Mailpit) ─────────────────────────────────────────
# 1) `make docker-infra` starts Mailpit (SMTP :1025, inbox http://localhost:8025).
# 2) Run mf-go on the host with Redis reachable (see REDIS_* above — docker Redis uses password devredis).
# 3) Uncomment and adjust:
# OTP_DELIVERY=email
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_PLAIN_NO_TLS=true
# SMTP_FROM=noreply@local.test
# (SMTP_USER/SMTP_PASSWORD empty for Mailpit)
#
# With OTP_DELIVERY=admin_panel, login/password-reset OTPs still go out by email when SMTP_* is
# complete (see docs/OTP_CONFIGURATION.md); open Mailpit to read them.
# Display name in OTP messages (falls back to SMTP_SUBJECT_PREFIX or MasterFabric).
OTP_APP_NAME=MasterFabric

# ───────────────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API (OTP_DELIVERY=whatsapp or whatsapp_both)
# ───────────────────────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph version path segment, e.g. v21.0
WHATSAPP_API_VERSION=v21.0

# ───────────────────────────────────────────────────────────────────────────────
# Telegram Bot API (OTP_DELIVERY=telegram or telegram_both)
# ───────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ───────────────────────────────────────────────────────────────────────────────
# SMTP (OTP email, admin test/user mail) — fallback when system_mail_smtp is off or incomplete
# Admins can configure primary SMTP in DB via GraphQL (see docs/OTP_CONFIGURATION.md §3b).
# ───────────────────────────────────────────────────────────────────────────────
# Typical production: SMTP_PORT=587, SMTP_IMPLICIT_TLS=false (STARTTLS).
# Port 465 (SMTPS): set SMTP_IMPLICIT_TLS=true.
#
# Local Mailpit (see deployments/docker-compose.yml): host localhost, port 1025,
#   SMTP_FROM=noreply@local.test, SMTP_PLAIN_NO_TLS=true
# AES-256 key for encrypting system_mail_smtp.password in Postgres (32 bytes as base64 or 64 hex chars).
# Generate: openssl rand -base64 32
# Strongly recommended in production when using admin Mail management.
MAIL_SMTP_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_SUBJECT_PREFIX=MasterFabric
SMTP_IMPLICIT_TLS=false
# Dev only (Mailpit/Mailhog). Must be false when ENV=production.
SMTP_PLAIN_NO_TLS=false
